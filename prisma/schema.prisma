generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Patient {
  id              String         @id @default(uuid())
  name            String
  phone           String         @unique
  altPhone        String?
  email           String?
  city            String?        @default("Bhubaneswar (Patia)")
  condition       String
  painScore       Int?           @default(7)
  leadSource      String         @default("Facebook Ads")
  campaignName    String?
  stage           String         @default("NEW_ENQUIRY")
  assignedDoctor  String?        @default("Dr. Ashok P. Kota (Master of Chiropractic)")
  packageName     String?
  packagePrice    Float?         @default(0)
  sessionsTotal   Int            @default(0)
  sessionsDone    Int            @default(0)
  notes           String?
  tags            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  conversation    Conversation?
  appointments    Appointment[]
  sessions        TreatmentSession[]
}

model Conversation {
  id              String         @id @default(uuid())
  patientId       String         @unique
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  unreadCount     Int            @default(0)
  lastMessageAt   DateTime       @default(now())
  status          String         @default("OPEN")
  assignedAgent   String?        @default("Reception Team")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  messages        Message[]
}

model Message {
  id              String         @id @default(uuid())
  conversationId  String
  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType      String
  text            String
  mediaUrl        String?
  mediaType       String?
  status          String         @default("SENT")
  isTemplate      Boolean        @default(false)
  templateName    String?
  language        String?        @default("en")
  createdAt       DateTime       @default(now())
}

model Appointment {
  id              String         @id @default(uuid())
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorName      String
  date            String
  timeSlot        String
  type            String         @default("Initial Spine & Posture Assessment")
  status          String         @default("SCHEDULED")
  notes           String?
  reminderSent24h Boolean        @default(false)
  reminderSent2h  Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model TreatmentSession {
  id              String         @id @default(uuid())
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessionNumber   Int
  date            DateTime       @default(now())
  therapiesGiven  String
  painScoreBefore Int?
  painScoreAfter  Int?
  therapistNotes  String?
  homeExercisePdf String?
  attended        Boolean        @default(true)
}

model BroadcastCampaign {
  id               String        @id @default(uuid())
  title            String
  targetCondition  String?
  messageTemplate  String
  language         String        @default("en")
  totalRecipients  Int           @default(0)
  sentCount        Int           @default(0)
  deliveredCount   Int           @default(0)
  readCount        Int           @default(0)
  status           String        @default("COMPLETED")
  scheduledFor     DateTime?
  createdAt        DateTime      @default(now())
}

model AutomationRule {
  id               String        @id @default(uuid())
  name             String
  triggerKeyword   String
  matchType        String        @default("CONTAINS")
  responseText     String
  mediaUrl         String?
  mediaType        String?
  language         String        @default("en")
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
}

model CannedResponse {
  id               String        @id @default(uuid())
  shortcut         String
  title            String
  language         String
  category         String
  message          String
}
